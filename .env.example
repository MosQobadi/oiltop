# Copy to .env and fill in real values for local development. Never commit .env.

# PostgreSQL connection string used by Prisma
# Port 5434 is used instead of the default 5432 to avoid clashing with a
# locally installed Postgres — adjust if your machine doesn't have that conflict.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5434/topoil?schema=public"

# Postgres credentials for docker-compose (must match the values embedded in DATABASE_URL above)
POSTGRES_USER=USER
POSTGRES_PASSWORD=PASSWORD
POSTGRES_DB=topoil

# Secret used to sign JWTs — generate a long random string, never reuse the example value
JWT_SECRET=change-me

# development | production
NODE_ENV=development

# Name of the HTTP-only auth cookie
COOKIE_NAME=topoil_session
