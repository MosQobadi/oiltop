// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Enums
// ---------------------------------------------------------------------------

enum UserRole {
  ADMIN
  CUSTOMER
}

enum UserStatus {
  ACTIVE
  INACTIVE
}

// How a category *behaves*, not what it contains — the catalog can grow to
// twenty categories without this growing at all. Only two things branch on it:
// the ENGINE_OIL climate rule (FitmentProfileItem below) and fitment group
// ordering (lib/storefront/fitment.ts). Anything that just needs to name a set
// of products wants the category itself, not a value added here.
enum PartType {
  ENGINE_OIL
  FILTER
  ACCESSORY
  OTHER
}

enum CategoryStatus {
  ACTIVE
  INACTIVE
}

enum BrandStatus {
  ACTIVE
  INACTIVE
}

enum ProductStatus {
  ACTIVE
  INACTIVE
}

enum CarBrandStatus {
  ACTIVE
  INACTIVE
}

enum CarModelStatus {
  ACTIVE
  INACTIVE
}

enum CarEngineStatus {
  ACTIVE
  INACTIVE
}

enum FuelType {
  PETROL
  DIESEL
  HYBRID
  ELECTRIC
  LPG_CNG
}

enum FitmentClimate {
  STANDARD
  HOT
  COLD
}

enum FitmentInquiryStatus {
  NEW
  CONTACTED
  RESOLVED
}

enum OrderStatus {
  PENDING
  SENDING
  SENT
  DELIVERED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
}

// ---------------------------------------------------------------------------
// Users
// ---------------------------------------------------------------------------

// Admins and storefront customers share this table but identify differently:
// an admin signs in with an email, a customer registers with a phone number and
// may never give an email at all (Design Decision 7). Both columns are
// therefore nullable-unique here, and the per-role rules — email required for
// ADMIN, phone required for CUSTOMER — live in Zod
// (`userIdentifiersSchema` in lib/validation/auth.ts), not in a DB constraint,
// so the rule can change without a migration.
model User {
  id           String     @id @default(cuid())
  email        String?    @unique
  phone        String?    @unique
  passwordHash String
  firstName    String
  lastName     String
  role         UserRole
  status       UserStatus
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt

  orders Order[]
}

// ---------------------------------------------------------------------------
// Catalog
// ---------------------------------------------------------------------------

model Category {
  id   String @id @default(cuid())
  slug String @unique

  // Importer bookkeeping — see the sourceRef comment on Product. The importer
  // creates exactly one category (the holding shelf in lib/import.ts), so today
  // this is set on at most one row; it exists so "which of these did the import
  // make" is the same question on every list, answered by the same column.
  sourceRef String? @unique

  nameEn String
  nameFa String

  tags String[]

  shortDescriptionEn String
  shortDescriptionFa String
  longDescriptionEn  String
  longDescriptionFa  String

  metaTitleEn       String?
  metaTitleFa       String?
  metaDescriptionEn String?
  metaDescriptionFa String?

  image  String?
  status CategoryStatus

  partType PartType

  // Where the category sits in the storefront's category lists (nav, home
  // browse section, PLP filter rail) — lowest first. Nullable rather than
  // `@default(0)` so "unordered" is a distinct state that sorts *after* the
  // pinned ones and stays alphabetical among itself; at 0 an untouched category
  // would outrank every category the admin had deliberately numbered.
  // Admin-facing lists ignore it — they stay newest-first for the review queue.
  sortOrder Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products            Product[]
  fitmentProfileItems FitmentProfileItem[]
  fitmentInquiries    FitmentInquiry[]
}

model Brand {
  id   String @id @default(cuid())
  slug String @unique

  // Importer bookkeeping — see the sourceRef comment on Product.
  sourceRef String? @unique

  nameEn String
  nameFa String

  logo   String?
  status BrandStatus

  // Where the brand sits in the storefront's brand lists (home browse section,
  // PLP and category-page filter rails) — lowest first. Nullable for the same
  // reason as Category.sortOrder: "unordered" has to sort *after* the pinned
  // brands, which `@default(0)` could not express.
  // Admin-facing lists ignore it — they stay newest-first for the review queue.
  sortOrder Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products Product[]
}

model Product {
  id  String @id @default(cuid())
  sku String @unique

  // Single, locale-independent URL segment — the storefront PDP is
  // /en/products/<slug> and /fa/products/<slug>, never slugEn/slugFa.
  slug String @unique

  // Where this row was imported from, formatted "<source>:<natural key in that
  // source>" — e.g. "oil-city:product/toyota-5w30-4l". It is the importer's
  // idempotency key: unique so a re-run updates the row it created last time
  // instead of inserting a duplicate, nullable because anything typed into the
  // admin panel has no source. Plumbing only — never surfaced in an admin form
  // or API response. Category, Brand, CarBrand and CarModel carry the same
  // field with the same convention.
  sourceRef String? @unique

  // The same oil in 1L / 4L / 5L is three rows, and without this they read as
  // three unrelated products. Every size of one product carries the same
  // arbitrary string here; null means "this one has no siblings".
  //
  // Deliberately a plain string rather than a parent/child relation or a
  // variants table: the only question it has to answer is "which other products
  // are this one in a different size", and a shared value answers it with an
  // index and no extra joins. If sizes ever need to differ in more than volume,
  // that's the point to reach for a real model — not before.
  variantGroup String?

  nameEn String
  nameFa String

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  brandId String
  brand   Brand  @relation(fields: [brandId], references: [id])

  price           Decimal
  discountPercent Int     @default(0)

  // Read-only: a Postgres generated column (see the add_product_final_price
  // migration), maintained by the database on every write to price or
  // discountPercent. Prisma can't express `GENERATED ALWAYS AS`, so it's mapped
  // as a dbgenerated default — never write to it, the database rejects it.
  //
  // It exists so the storefront's price sort can be an indexed ORDER BY rather
  // than a sort in Node. Read paths still compute the same value themselves
  // (server/product.ts, lib/services/*) — that stays the source of the number
  // callers see, and this column stays the thing the database orders by, which
  // is why lib/db.ts omits it from selects globally.
  finalPrice Decimal @default(dbgenerated())

  tags           String[]
  oemPartNumbers String[]

  // The specs a customer actually shops on, lifted out of the descriptions and
  // the untyped `tags` array so they can be queried rather than only read.
  // Normalised uppercase on the way in (see lib/validation/product.ts) — "5w30"
  // typed into the admin form and "5W-30" written by the importer have to end
  // up as the same value or the filter they exist for silently misses rows.
  viscosity String? // "5W-30"
  apiGrade  String? // "SN"
  volumeMl  Int? // 4000

  // Everything else worth recording but not worth a column of its own — same
  // role as FitmentProfileItem.specAttributes. Written by the importer; not
  // editable in the admin UI.
  specs Json?

  shortDescriptionEn String
  shortDescriptionFa String
  longDescriptionEn  String
  longDescriptionFa  String

  metaTitleEn       String?
  metaTitleFa       String?
  metaDescriptionEn String?
  metaDescriptionFa String?

  image  String?
  status ProductStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inventory           Inventory?
  orderItems          OrderItem[]
  fitmentProfileItems FitmentProfileItem[]
  stockNotifications  StockNotification[]
  priceLogs           ProductPriceLog[]

  @@index([categoryId])
  @@index([brandId])
  // The PDP's sibling lookup is "same variantGroup, different id" on every
  // product that has one — an unindexed scan of the whole catalog otherwise.
  @@index([variantGroup])
  // The PLP's price sort orders by this column directly.
  @@index([finalPrice])
}

// Append-only price history. A row means "from changedAt onward this product
// cost this much" — written by the admin product update route only when price
// or discountPercent actually changes, so an unrelated edit doesn't pollute the
// history. Storefront checkout reads it to honour a cart price captured within
// the last 24 hours instead of trusting a client-submitted price
// (Design Decision 8); a product with no rows has never been re-priced, so its
// current price applies. changedAt is this model's createdAt — the rows are
// never updated, so a separate createdAt/updatedAt pair would only be noise.
model ProductPriceLog {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  price           Decimal
  discountPercent Int

  changedAt DateTime @default(now())

  @@index([productId, changedAt])
}

// Back-in-stock waiting list, created anonymously from the storefront PDP when
// a product is out of stock. `contact` is whatever the customer typed — an
// email or a phone number — because the storefront asks for one field, not
// two. Sending the notification and stamping notifiedAt is the admin
// Inventory route's job when stock moves 0 -> >0 (storefront Task 0.6); this
// model only captures the request.
model StockNotification {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id])

  contact String

  notifiedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId, notifiedAt])
}

// stock thresholds (derived, not stored): 0 = out of stock, <10 = low stock, otherwise in stock
model Inventory {
  id            String   @id @default(cuid())
  productId     String   @unique
  product       Product  @relation(fields: [productId], references: [id])
  stock         Int      @default(0)
  lastUpdatedAt DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ---------------------------------------------------------------------------
// Cars & Fitment
// ---------------------------------------------------------------------------

model CarBrand {
  id   String @id @default(cuid())
  slug String @unique

  // Importer bookkeeping — see the sourceRef comment on Product.
  sourceRef String? @unique

  nameEn String
  nameFa String

  logo   String?
  status CarBrandStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  models CarModel[]
}

model CarModel {
  id String @id @default(cuid())

  carBrandId String
  carBrand   CarBrand @relation(fields: [carBrandId], references: [id])

  // Importer bookkeeping — see the sourceRef comment on Product.
  sourceRef String? @unique

  nameEn String
  nameFa String
  slug   String

  metaTitleEn       String?
  metaTitleFa       String?
  metaDescriptionEn String?
  metaDescriptionFa String?

  image  String?
  status CarModelStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  engines CarEngine[]

  @@unique([carBrandId, slug])
  @@index([carBrandId])
}

model CarEngine {
  id String @id @default(cuid())

  carModelId String
  carModel   CarModel @relation(fields: [carModelId], references: [id])

  labelEn String
  labelFa String

  yearStart Int
  yearEnd   Int? // nullable means still in production

  // A photo of this specific type, for the car finder's type step: a 206 Type 2
  // and a Type 5 don't look alike, and neither does a 2015 Tucson next to a 2025
  // one. Null means "no photo of its own" and falls back to the model's image —
  // see variantImage() in lib/storefront/fitment.ts. Nothing reads this column
  // directly, so the fallback can never be skipped by accident.
  image String?

  fuelType       FuelType
  displacementCc Int?
  engineCode     String?
  status         CarEngineStatus

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  fitmentProfileLinks CarEngineFitmentProfile[]
  fitmentInquiries    FitmentInquiry[]

  @@index([carModelId])
}

// A reusable set of fitment recommendations, attached to any number of CarEngine
// rows via CarEngineFitmentProfile — this lets one profile (e.g. "Peugeot 206
// TU5 1.6 8v — Standard") cover many engines without re-entering the same rows
// per engine. See Design Decision 9 in topoil-admin-claude-code-tasks.md.
model FitmentProfile {
  id String @id @default(cuid())

  // Internal admin-only identifier, never shown to a customer — the deliberate
  // exception to the bilingual nameEn/nameFa convention (see CLAUDE.md).
  label        String
  internalNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items          FitmentProfileItem[]
  carEngineLinks CarEngineFitmentProfile[]
}

// climate must be STANDARD unless the related category's partType is ENGINE_OIL —
// enforced as a Zod cross-field rule (lib/validation/), not a DB constraint.
// priority orders items when a category+climate has more than one valid item
// (e.g. two acceptable oil filter brands) — they're co-equal options, not a
// fallback chain.
model FitmentProfileItem {
  id String @id @default(cuid())

  profileId String
  profile   FitmentProfile @relation(fields: [profileId], references: [id])

  categoryId String
  category   Category @relation(fields: [categoryId], references: [id])

  climate FitmentClimate @default(STANDARD)

  productId String?
  product   Product? @relation(fields: [productId], references: [id])

  specNote       String?
  specAttributes Json?

  // A query against the catalog, not text for a customer: the item resolves to
  // whatever ACTIVE products in its category currently match, so "this engine
  // takes 5W-30, API SN" survives a product going out of stock instead of the
  // recommendation dying with the one row it was pinned to.
  //
  //   { viscosity?: string, apiGrade?: string, volumeMl?: number }
  //
  // — the three structured spec columns on Product, matched exactly, and every
  // key present has to match. specAttributes stays what it is: display text for
  // the spec-only card. An item may carry both; `productId` still wins.
  matchSpec Json?

  priority  Int     @default(0)
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([profileId])
  @@index([categoryId])
  @@index([productId])
}

model CarEngineFitmentProfile {
  id String @id @default(cuid())

  carEngineId String
  carEngine   CarEngine @relation(fields: [carEngineId], references: [id])

  profileId String
  profile   FitmentProfile @relation(fields: [profileId], references: [id])

  createdAt DateTime @default(now())

  // carEngineId needs no index of its own — the composite unique above is a
  // btree keyed on it, so a lookup by engine already has index support.
  @@unique([carEngineId, profileId])
  @@index([profileId])
}

model FitmentInquiry {
  id String @id @default(cuid())

  carEngineId String?
  carEngine   CarEngine? @relation(fields: [carEngineId], references: [id])

  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])

  customerName String
  phone        String
  email        String?
  message      String?

  status    FitmentInquiryStatus
  adminNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([carEngineId])
  @@index([categoryId])
}

// ---------------------------------------------------------------------------
// Orders
// ---------------------------------------------------------------------------

// A guest checkout produces an order with no account behind it (Design
// Decision 6), so `customerId` is null and the guest* fields carry the contact
// details the checkout form collected. Exactly one of the two is ever set.
// `onDelete: Restrict` is spelled out because Prisma's default for an optional
// relation is SET NULL, which would quietly turn a deleted customer's order
// into an unattributable guest order.
model Order {
  id String @id @default(cuid())

  customerId String?
  customer   User?   @relation(fields: [customerId], references: [id], onDelete: Restrict)

  guestName  String?
  guestPhone String?
  guestEmail String?

  status        OrderStatus
  paymentStatus PaymentStatus

  subtotal     Decimal
  discount     Decimal
  shippingCost Decimal
  tax          Decimal
  total        Decimal

  shippingAddress String
  postalCode      String
  adminNote       String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items OrderItem[]
}

// snapshot fields exist so historical orders don't change if the product is edited later.
model OrderItem {
  id String @id @default(cuid())

  orderId String
  order   Order  @relation(fields: [orderId], references: [id])

  productId String
  product   Product @relation(fields: [productId], references: [id])

  productNameSnapshot String
  priceSnapshot       Decimal
  quantity            Int
  lineTotal           Decimal

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

// ---------------------------------------------------------------------------
// Settings
// ---------------------------------------------------------------------------

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
