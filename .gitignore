# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example
!.env.test.example

# vercel
.vercel

# user-uploaded content
/public/uploads

# raw scrape output — batch files per source, not source code. The one committed
# sample lives at lib/validation/__fixtures__/scrape-batch.json instead, so a
# real import run can never pick the fixture up as a batch.
/scrape/

# typescript
*.tsbuildinfo
next-env.d.ts

/lib/generated/prisma

# graphify
/graphify-out/

# playwright
/e2e/.auth/
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# scratch docs
/storefront-design-brief.md
/docs/
/topoil-storefront.excalidraw
