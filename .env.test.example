# Copy to .env.test for local Playwright E2E runs. Never commit .env.test.
# Points at the dedicated db_test service (see docker-compose.yml) so the
# E2E suite's truncate-and-reseed never touches the day-to-day dev database.

DATABASE_URL="postgresql://USER:PASSWORD@localhost:5435/topoil_test?schema=public"

TEST_POSTGRES_USER=USER
TEST_POSTGRES_PASSWORD=PASSWORD
TEST_POSTGRES_DB=topoil_test

JWT_SECRET=change-me

NODE_ENV=development

COOKIE_NAME=topoil_session

# Port the Next.js dev server binds to during E2E runs.
E2E_PORT=3100
