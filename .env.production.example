# Copy to .env.production ON THE VPS and fill in real values. Never commit the
# filled-in file — it holds live secrets.
#
# Every compose command must pass `--env-file .env.production` (not just rely on
# `env_file:` in the compose file), because TOPOIL_PORT and NEXT_PUBLIC_SITE_URL
# are interpolated by Compose itself before any container exists. See
# DEPLOYMENT.md.

# Prisma's connection string. The host is `postgres` — the compose service name,
# reachable over the compose network — not `localhost`, and not the port the
# local dev database uses.
DATABASE_URL="postgresql://topoil:REPLACE_WITH_STRONG_PASSWORD@postgres:5432/topoil?schema=public"

# Postgres credentials for the `postgres` service. These must match the user,
# password and database embedded in DATABASE_URL above.
POSTGRES_USER=topoil
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_PASSWORD
POSTGRES_DB=topoil

# Signs the admin session JWT. Generate with: openssl rand -base64 48
JWT_SECRET=REPLACE_WITH_LONG_RANDOM_STRING

NODE_ENV=production
COOKIE_NAME=topoil_session

# Public origin, no trailing slash. Baked into the build (sitemap.xml,
# robots.txt, canonical URLs) as well as read at runtime.
NEXT_PUBLIC_SITE_URL=https://oil-top.ir

# Loopback port the app container is published on for the host's nginx to
# proxy to. Must be free on the VPS and must match the `proxy_pass` port in
# deploy/nginx/oil-top.ir.conf. Check it is unused before first deploy:
#   sudo ss -tlnp | grep :3001
TOPOIL_PORT=3001
